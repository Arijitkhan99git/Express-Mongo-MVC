PORT=8000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=expressDB

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=5m

# How long a refresh token lasts (days). After this the user must log in again.
REFRESH_TOKEN_EXPIRES_DAYS=7



# Websites allowed to call this API from a browser (comma separated, no trailing slash).
# Leave empty to block all browser cross-origin calls. Postman/curl are not affected.
CORS_ORIGINS=http://localhost:3000
